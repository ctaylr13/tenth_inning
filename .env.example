# Copy to .env before starting anything:  cp .env.example .env
# .env is gitignored; this file is the committed shape of it.

# local postgres (docker-compose.yml) -- credentials are local-only
POSTGRES_USER=tenth_inning
POSTGRES_PASSWORD=tenth_inning
POSTGRES_DB=tenth_inning

# From inside another container in this compose file the host is `postgres` and
# the port is 5432 -- container-to-container traffic never touches the published
# port at all.
DATABASE_URL=postgresql://tenth_inning:tenth_inning@127.0.0.1:5433/tenth_inning

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174
