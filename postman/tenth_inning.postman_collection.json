{
    "info": {
        "_postman_id": "959f4057-df00-48a2-b3d9-ab195f21c4a5",
        "name": "tenth_inning artifact delivery",
        "description": "Checks the API response and direct signed-URL download. Protobuf decoding, Arrow conversion, DuckDB-WASM registration, and browser CORS stay in frontend tests.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Get game and signed artifact URL",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Game detail returns 200\", () => {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "const body = pm.response.json();",
                            "pm.test(\"Game detail matches the requested game\", () => {",
                            "    pm.expect(String(body.gamePk)).to.eql(pm.environment.get(\"game_pk\"));",
                            "});",
                            "pm.test(\"A delivered artifact has a signed URL\", () => {",
                            "    pm.expect(body.artifact_url).to.be.a(\"string\").and.not.empty;",
                            "});",
                            "",
                            "if (body.artifact_url) {",
                            "    pm.environment.set(\"artifact_url\", body.artifact_url);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": "{{base_url}}/api/games/{{game_pk}}",
                "description": "Reads game detail and saves artifact_url into the active environment. Run this again whenever the signed URL expires."
            },
            "response": []
        },
        {
            "name": "2. Download Protobuf artifact",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Signed URL returns 200\", () => {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"Artifact response has bytes\", () => {",
                            "    const contentLength = Number(pm.response.headers.get(\"Content-Length\"));",
                            "    pm.expect(contentLength).to.be.above(0);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/x-protobuf",
                        "type": "text"
                    }
                ],
                "url": "{{artifact_url}}",
                "description": "Downloads opaque Protobuf bytes directly from the signed GCS URL. Postman does not pass these bytes to DuckDB."
            },
            "response": []
        }
    ]
}
